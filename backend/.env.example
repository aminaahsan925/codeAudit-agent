# Copy to .env and fill in. Never commit a real .env.
# Nebius Token Factory (Phase 2: live Nemotron integration)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Resolve the real model id at runtime via:
#   python scripts/check_token_factory.py
# Do NOT copy a model identifier from an old guide.
NEMOTRON_MODEL=

# AI reasoning layer (Phase 2) — all bounded, all optional
CODEAUDIT_AI_ENABLED=true
CODEAUDIT_AI_TEMPERATURE=0.2
CODEAUDIT_AI_MAX_TOKENS=2000
CODEAUDIT_AI_TIMEOUT_SECONDS=60
CODEAUDIT_AI_MAX_RETRIES=2
# Context budget: hard caps on what is ever sent to the model
CODEAUDIT_AI_MAX_CONTEXT_CHARS=24000
CODEAUDIT_AI_MAX_CONTEXT_FILES=12
CODEAUDIT_AI_MAX_FILE_CHARS=6000
CODEAUDIT_AI_MAX_FINDINGS=25
CODEAUDIT_AI_CONTEXT_LINES=15
# Reasoning-model deployments that reject response_format: set to "none"
# to omit it (prompts still demand JSON-only; parser recovers fenced JSON).
# CODEAUDIT_AI_RESPONSE_FORMAT=json_object

# --- AI provider selection ---
# nebius (default, hackathon target) or groq (opt-in, free no-card tier for
# live AI-layer testing). Nebius setup above is untouched.
# CODEAUDIT_AI_PROVIDER=groq
# GROQ_API_KEY=<your-groq-key>
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Remediation (Phase 3: FIND -> FIX -> VERIFY) — all bounded, all optional
CODEAUDIT_FIX_MAX_CONTEXT_CHARS=12000
CODEAUDIT_FIX_MAX_FILE_CHARS=4000
CODEAUDIT_FIX_CONTEXT_LINES=20
CODEAUDIT_FIX_TEMPERATURE=0.2
CODEAUDIT_FIX_MAX_TOKENS=1500
CODEAUDIT_FIX_MAX_CHANGES=5
CODEAUDIT_MAX_REMEDIATIONS_PER_REQUEST=3

# Multi-agent backend (Phase 3 upgrade): cost-controlled Nemotron usage.
# free = zero Nebius calls (default); economy = 1 analysis + 1 remediation
# call; full = 4 analysis + 2 remediation calls. Explicit caps below
# override the mode defaults (never unlimited).
CODEAUDIT_AGENT_MODE=free
# CODEAUDIT_MAX_AI_CALLS_PER_ANALYSIS=1
# CODEAUDIT_MAX_AI_CALLS_PER_REMEDIATION=1

# GitHub (optional; raises API rate limits for metadata fetching)
GITHUB_TOKEN=

# Scanner safety limits (defaults shown)
CODEAUDIT_MAX_FILE_SIZE=1000000
CODEAUDIT_MAX_FILES=2000
CODEAUDIT_MAX_TOTAL_BYTES=50000000
CODEAUDIT_CLONE_TIMEOUT=120
CODEAUDIT_MAX_FUNCTION_LINES=50
# Wall-clock budget (seconds) for the deterministic analysis stages
# (scan, parse, analyze) of one run; <= 0 disables. Breach -> HTTP 504.
CODEAUDIT_MAX_ANALYSIS_SECONDS=600

# Logging
CODEAUDIT_LOG_LEVEL=INFO

# --- Supply chain (Phase 4) ---
# Local advisory DB for dependency vulnerability matching. See data/advisories.example.json
# for the schema and scripts/refresh_advisories.py to populate it from OSV.dev.
# Without a populated DB, no dependency vulnerability is ever reported.
# CODEAUDIT_ADVISORY_DB=data/advisories.json
# CODEAUDIT_ADVISORY_MAX_AGE_DAYS=30

# Curated knowledge base (Phase 5): remediation guidance shown to the model
# alongside findings. Knowledge-only: it never determines whether a finding
# exists. Retrieval is deterministic, local, and runs in every agent mode.
# CODEAUDIT_KB_MAX_CHUNKS_PER_FINDING=3
# CODEAUDIT_KB_MAX_CHARS=4000

# --- Live website scanning (Phase 6) ---
# Authorization tokens for POST /scan/website: "host:token,host2:token2".
# A scan runs ONLY when the request supplies the token configured for the
# target host AND sets i_authorize_this_scan=true. Compared with
# hmac.compare_digest; never logged. Empty = every scan is refused (403).
# Scanning a system you are not permitted to test may be illegal.
# CODEAUDIT_SCAN_TOKENS=example.com:replace-with-a-long-random-token
# Allow loopback targets (127.0.0.1/localhost/::1). For hermetic tests
# against a fixture server ONLY — keep false in production.
CODEAUDIT_SCAN_ALLOW_LOCALHOST=false
# Scan budgets: pages, requests, delay between requests (ms), per-request
# timeout (s), redirect hops, response bytes, total scan seconds.
CODEAUDIT_SCAN_MAX_PAGES=50
CODEAUDIT_SCAN_MAX_REQUESTS=200
CODEAUDIT_SCAN_REQUEST_DELAY_MS=250
CODEAUDIT_SCAN_TIMEOUT_SECONDS=10
CODEAUDIT_SCAN_MAX_REDIRECTS=5
CODEAUDIT_SCAN_MAX_RESPONSE_BYTES=1000000
CODEAUDIT_SCAN_MAX_SECONDS=300

# --- Persistence / SaaS infrastructure (Phase 7) ---
# Database URL. SQLite is the dev default (relative sqlite:/// paths resolve
# against backend/); Postgres is the production target, e.g.
# postgresql+psycopg2://user:pass@host:5432/codeaudit
CODEAUDIT_DATABASE_URL=sqlite:///./codeaudit.db
# Require X-API-Key on all endpoints except /health (default false = dev mode).
CODEAUDIT_REQUIRE_AUTH=false
# Dev-only: on startup, create a dev user + admin API key and print it to
# stdout ONCE. Default false. Never enable in production.
CODEAUDIT_DEV_BOOTSTRAP_KEY=false
# Record completed analyses/scans (+ finding snapshots) in the DB.
CODEAUDIT_PERSISTENCE_ENABLED=true
# DEV-ONLY in-process background job worker. Production: separate process.
CODEAUDIT_JOB_WORKER=false
CODEAUDIT_WEBHOOK_URL=
CODEAUDIT_WEBHOOK_SECRET=
